# Required server configuration. Do not commit a populated .env file.
DB_URL=jdbc:mysql://localhost:3306/storix
DB_USERNAME=storix_app
DB_PASSWORD=replace-with-a-database-password
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8080/api/accounts/google/callback
# Base64-encoded random value, at least 32 bytes before encoding.
JWT_SECRET=replace-with-a-base64-encoded-32-byte-secret
# Base64-encoded, 32-byte AES key used to encrypt OAuth tokens at rest.
TOKEN_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key
FRONTEND_URL=http://localhost:5173
# Comma-separated browser origins allowed to call the API.
CORS_ALLOWED_ORIGINS=http://localhost:5173
SHOW_SQL=false
FORMAT_SQL=false
