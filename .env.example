# Docker Compose configuration. Copy to .env and replace every placeholder.
MYSQL_DATABASE=storix
MYSQL_USER=storix_app
MYSQL_PASSWORD=replace-with-a-long-random-password
MYSQL_ROOT_PASSWORD=replace-with-a-separate-long-random-password
JWT_SECRET=replace-with-a-base64-encoded-32-byte-secret
TOKEN_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret
# When using Docker Compose locally, register this exact callback in Google Cloud.
GOOGLE_REDIRECT_URI=http://localhost:8081/api/accounts/google/callback
# Browser origin allowed to call the backend directly. The Compose frontend uses /api proxying.
CORS_ALLOWED_ORIGINS=http://localhost:8081
